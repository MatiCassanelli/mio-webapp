{
  "name": "mio-webapp",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-date-pickers": "^8.0.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.101",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "dayjs": "^1.11.11",
    "firebase": "^10.12.3",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:all": "npm run build && firebase deploy",
    "emulators": "firebase emulators:start --only firestore,functions",
    "start:local": "REACT_APP_USE_EMULATOR=true react-scripts start",
    "seed:local": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/seed.mjs",
    "migrate:local": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/migrate-transactions.mjs",
    "snapshot:dump": "node scripts/snapshot.mjs dump",
    "snapshot:load": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/snapshot.mjs load",
    "verify:local": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node scripts/verify-migration.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
